# Copy to .env and adjust. Secrets (Stripe, Web3Forms) live in .env.local.

# Prisma — SQLite file relative to prisma/ dir. For Postgres later:
# DATABASE_URL="postgresql://user:pass@host:5432/nosiadek?schema=public"
DATABASE_URL="file:./dev.db"

# Storage layer (SE-1)
# local = files under STORAGE_LOCAL_ROOT on disk (VPS/dev)
# s3    = S3-compatible (Cloudflare R2) — stub only until hosting is decided
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# Required only when STORAGE_DRIVER=s3:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=nosiadek-art
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.michalnosiadek.com
